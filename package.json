{
  "name": "parallel-dupe-finder",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "parallel-dupe-finder": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p benchmark",
    "bench:data": "tsx benchmark/generate-dataset.ts",
    "bench": "tsx benchmark/run.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "type": "module",
  "keywords": ["duplicate", "duplicates", "dedupe", "files", "cli", "worker-threads", "hash"],
  "author": "Vardan Sharma",
  "license": "MIT",
  "description": "Find duplicate files fast, hashing in parallel on a pool of worker threads",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarezKwiup/parallel-dupe-finder.git"
  },
  "homepage": "https://github.com/MarezKwiup/parallel-dupe-finder#readme",
  "bugs": "https://github.com/MarezKwiup/parallel-dupe-finder/issues",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
